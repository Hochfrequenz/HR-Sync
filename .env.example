# Copy this file to .env and fill in the values. Never commit the .env file.
# See section 7 of docs/plans/2026-10-28-umsetzungsplan.md for the meaning of the variables.

# Personio API v2: credentials with only the scope personio:persons:read
PERSONIO_CLIENT_ID=
PERSONIO_CLIENT_SECRET=
PERSONIO_APP_ID=HR_SYNC
PERSONIO_EMPLOYEE_NUMBER_ATTRIBUTE=company_employee_id

# weclapp: set either WECLAPP_TENANT or WECLAPP_BASE_URL
WECLAPP_API_TOKEN=
WECLAPP_TENANT=
# WECLAPP_BASE_URL=
WECLAPP_EMPLOYEE_NUMBER_ATTRIBUTE_KEY=personalnummer
WECLAPP_NEW_USER_STATUS=ACTIVE

# Decidalo import API (production)
DECIDALO_API_KEY=
DECIDALO_EMPLOYEE_TYPE_NAME=Internal
DECIDALO_HAS_LOGIN=true

# Decidalo test environment: only read with HR_SYNC_ENVIRONMENT=test and by the integration tests
DECIDALO_TEST_BASE_URL=
DECIDALO_TEST_API_KEY=

# HR-Sync
# production or test (test anonymizes the data and only allows the Decidalo test environment as target)
HR_SYNC_ENVIRONMENT=production
# pretty or json
HR_SYNC_LOG_FORMAT=pretty
